# Copie ce fichier en .env.local puis remplis les valeurs.
# .env.local n'est jamais versionné : la clé d'API reste sur ta machine
# et dans les variables d'environnement de l'hébergeur (Vercel, Netlify…).

# ── LETTRE D'INFORMATION — BREVO ──────────────────────────────────────────
# 1. Crée un compte gratuit sur https://www.brevo.com
# 2. Clé d'API : Menu profil › SMTP & API › Clés API › Générer une nouvelle clé
#    (elle commence par "xkeysib-")
# 3. Identifiant de liste : Contacts › Listes › ouvre ta liste,
#    le numéro est visible dans l'URL et à côté du nom de la liste
BREVO_API_KEY=
BREVO_LIST_ID=
